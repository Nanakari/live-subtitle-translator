{
  "manifest_version": 3,
  "name": "Gemini Live Translator",
  "version": "0.3.1",
  "description": "Translate the audio of the current tab with a local Gemini Live bridge.",
  "permissions": ["activeTab", "offscreen", "scripting", "storage", "tabCapture", "tabs"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "Gemini Live Translator", "default_popup": "popup.html" }
}
